# Ship Tracker — environment template.
#
# Copy this file to `.env` (which is gitignored) and fill in the
# values you have. Both `docker compose up` services (`app` + `worker`)
# auto-load this file via the `env_file:` directive in
# docker-compose.yml — no `--env-file` flag needed.
#
# Every key is optional at the process level: a missing key degrades
# the corresponding data source to a synthetic-data fallback or a
# "not configured" status panel rather than crashing the app or worker.
# In practice you want at minimum FRED_API_KEY for the macro tabs and
# ANTHROPIC_API_KEY for the AI briefing/narration features.
#
# For Streamlit Cloud deploys, set these as TOML in
# .streamlit/secrets.toml instead — see .streamlit/secrets.toml.example.

# ── AI / LLM ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Data feeds ──────────────────────────────────────────────────────────
FRED_API_KEY=
# NOTE: the code reads ALPHA_VANTAGE_KEY and NEWS_API_KEY (not *_API_KEY / NEWSAPI_KEY).
ALPHA_VANTAGE_KEY=
NEWS_API_KEY=
AISSTREAM_KEY=

# ── App authentication (hashed-password gate) ──────────────────────────
# Used by the optional password-gate in front of the Streamlit app.
# Generate via `python -m utils.password_hash <password>`.
APP_PASSWORD_HASH=
APP_PASSWORD_SALT=

# ── SMTP (email alert delivery) ─────────────────────────────────────────
# Required only if you add an email DeliveryChannel in the alert-routing
# UI. SMTP_PORT defaults to 587 (STARTTLS submission).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ── Twilio (SMS alert delivery — optional) ─────────────────────────────
# Required only if you add an SMS DeliveryChannel in the alert-routing
# UI. Leave blank to disable SMS support entirely.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Webhook listener (inbound alert acknowledgement) ──────────────────
# Shared HMAC SHA256 secret used by the ack webhook listener
# (worker/webhook_listener.py, exposed by the `webhook` docker-compose
# service on port 8502). Every POST to /ack/{alert_id}, /ack-all, or
# /webhooks/pagerduty must carry a matching X-Signature-SHA256
# (or X-PagerDuty-Signature) header.
#
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Recommended: ≥ 32 random bytes (64 hex chars). An empty value causes
# every request to fail HMAC verification with 401 — safe by default.
WEBHOOK_SECRET=

# ── Secrets vault (opt-in encrypted delivery-channel targets) ──────────
# Master key for state.vault — wraps sensitive ``delivery_channels.target``
# values (Slack webhook URLs, PagerDuty integration keys, etc.) in a
# self-describing ``vault:v1:<base64>`` envelope at rest in SQLite.
#
# Threat model: this protects against casual DB leaks (a copied-off
# ``ship_tracker.db`` or a leaked ``bulk_export.tar.gz``) — NOT against
# an attacker with access to the running process (anyone who can read
# this env var can read every secret).
#
# When VAULT_KEY is unset the vault auto-generates a master key on
# first use and stores it in kv_state — convenient for local dev but
# equivalent to "no encryption at rest" against a DB-file leak.
# **Production deployments must set VAULT_KEY** so the master key lives
# outside the DB.
#
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
VAULT_KEY=
